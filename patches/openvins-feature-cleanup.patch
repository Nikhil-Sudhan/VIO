+namespace {
+// Keep parallel observations in stable order with one compaction pass. Erasing
+// each old item separately shifts the remaining history repeatedly (quadratic
+// work after a long stationary period). The selection predicates are unchanged.
+template <typename Keep> void retain_measurements(Feature &feature, Keep keep) {
+  for (auto &entry : feature.timestamps) {
+    auto &times = entry.second;
+    auto &uv = feature.uvs.at(entry.first);
+    auto &norm = feature.uvs_norm.at(entry.first);
+    assert(times.size() == uv.size());
+    assert(times.size() == norm.size());
+    size_t out = 0;
+    for (size_t in = 0; in < times.size(); ++in) {
+      if (!keep(times[in])) continue;
+      if (out != in) {
+        times[out] = times[in];
+        uv[out] = uv[in];
+        norm[out] = norm[in];
       }
+      ++out;
     }
+    times.resize(out);
+    uv.resize(out);
+    norm.resize(out);
   }
 }
+}
 
